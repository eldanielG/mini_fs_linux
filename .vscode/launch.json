{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug MiniFS (gcc + gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/mini_fs",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "preLaunchTask": "Build MiniFS (Makefile)",
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}