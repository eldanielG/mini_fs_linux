{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build MiniFS (Makefile)",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Clean MiniFS (Makefile)",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Build MiniFS (Direct GCC)",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "src/main.c",
                "src/filesystem.c",
                "-I",
                "include",
                "-o",
                "mini_fs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Run MiniFS",
            "command": "./mini_fs",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["Build MiniFS (Makefile)"],
            "problemMatcher": []
        }
    ]
}